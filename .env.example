# AP Onion Agentic AI — environment template (copy to `.env` and fill)

# --- Real data -------------------------------------------------------------
# Path to the curated AGMARKNET-derived dataset (defaults to Desktop copy)
# REAL_DATA_CSV=C:\Users\syamm\OneDrive\Desktop\AP_Onion_Dataset_2022_2026_Production.csv

# ONLY for dev/playground: re-loads the old synthetic demo rows (flags them
# is_demo_data=True). NEVER set this for client demos.
# SEED_SYNTHETIC=false

# --- Chronos-2 foundation model --------------------------------------------
# Weights load strictly from the local HF cache by default (no network in
# request paths). Pre-download once:
#   huggingface-cli download amazon/chronos-2
# Set to true to allow lazy hub download (not recommended for the demo):
# CHRONOS_ALLOW_DOWNLOAD=false

# --- Local LLM (agentic chat orchestrator) ---------------------------------
# IMPORTANT: model must fit machine RAM. 14B models need ~10GB and will fail
# to allocate on 7.5GB machines (CPU_REPACK error). qwen2.5:3b-instruct (~2.3GB)
# is the safe default; qwen2.5:7b only with closed heavy apps on 16GB.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Web fallback (Market Agent escalation, citation-only) ------------------
TAVILY_API_KEY=
